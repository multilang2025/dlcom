[{"id":"e3295b5","elType":"container","settings":[],"elements":[{"id":"faf9f0a","elType":"widget","settings":{"editor":"<div style=\"background:#f5f5f5;border-left:4px solid #007BB3;padding:20px 24px;border-radius:8px\"><h2>\u041e\u043d\u043b\u0430\u0439\u043d-\u0431\u0438\u0437\u043d\u0435\u0441 \u0432 \u0418\u0441\u043f\u0430\u043d\u0438\u0438: \u0433\u043b\u0430\u0432\u043d\u043e\u0435<\/h2><ul><li>\u041e\u043d\u043b\u0430\u0439\u043d-\u0431\u0438\u0437\u043d\u0435\u0441 \u0432 \u0418\u0441\u043f\u0430\u043d\u0438\u0438 \u043c\u043e\u0436\u043d\u043e \u0432\u0435\u0441\u0442\u0438 \u043a\u0430\u043a \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u0440\u0435\u0434\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c (aut\u00f3nomo), \u043e\u0442\u0432\u0435\u0447\u0430\u044e\u0449\u0438\u0439 \u043f\u043e \u0434\u043e\u043b\u0433\u0430\u043c \u0432\u0441\u0435\u043c \u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u043c, \u0438\u043b\u0438 \u0447\u0435\u0440\u0435\u0437 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e \u0441 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u043e\u0439 \u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c\u044e (SL) \u0441 \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u043c \u043a\u0430\u043f\u0438\u0442\u0430\u043b\u043e\u043c 1 \u0435\u0432\u0440\u043e.<\/li><li>\u041e\u0431\u0449\u0430\u044f \u0441\u0442\u0430\u0432\u043a\u0430 \u041d\u0414\u0421 (IVA) \u0432 \u0418\u0441\u043f\u0430\u043d\u0438\u0438 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 21% (<a href=\"https:\/\/www.boe.es\/buscar\/act.php?id=BOE-A-1992-28740#a90\" target=\"_blank\" rel=\"nofollow noopener\">\u0441\u0442\u0430\u0442\u044c\u044f 90 \u0417\u0430\u043a\u043e\u043d\u0430 \u043e\u0431 \u041d\u0414\u0421<\/a>).<\/li><li>\u0415\u0441\u043b\u0438 \u043f\u0440\u043e\u0434\u0430\u0436\u0438 \u0442\u043e\u0432\u0430\u0440\u043e\u0432 \u0438 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u044b\u0445 \u0443\u0441\u043b\u0443\u0433 \u0447\u0430\u0441\u0442\u043d\u044b\u043c \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u044f\u043c \u0432 \u0434\u0440\u0443\u0433\u0438\u0435 \u0441\u0442\u0440\u0430\u043d\u044b \u0415\u0421 \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u044e\u0442 10 000 \u0435\u0432\u0440\u043e \u0432 \u0433\u043e\u0434, \u041d\u0414\u0421 \u0443\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u043f\u043e \u0441\u0442\u0430\u0432\u043a\u0435 \u0441\u0442\u0440\u0430\u043d\u044b \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u044f (<a href=\"https:\/\/www.boe.es\/buscar\/act.php?id=BOE-A-1992-28740#a73\" target=\"_blank\" rel=\"nofollow noopener\">\u0441\u0442\u0430\u0442\u044c\u044f 73 \u0417\u0430\u043a\u043e\u043d\u0430 \u043e\u0431 \u041d\u0414\u0421<\/a>).<\/li><li>\u041d\u0414\u0421 \u0434\u0440\u0443\u0433\u0438\u0445 \u0441\u0442\u0440\u0430\u043d \u0415\u0421 \u0438\u0441\u043f\u0430\u043d\u0441\u043a\u0430\u044f \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u044f \u043c\u043e\u0436\u0435\u0442 \u0434\u0435\u043a\u043b\u0430\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0447\u0435\u0440\u0435\u0437 \u0435\u0434\u0438\u043d\u043e\u0435 \u043e\u043a\u043d\u043e OSS (\u0440\u0435\u0436\u0438\u043c \u0421\u043e\u044e\u0437\u0430) \u0435\u0436\u0435\u043a\u0432\u0430\u0440\u0442\u0430\u043b\u044c\u043d\u043e\u0439 \u0434\u0435\u043a\u043b\u0430\u0440\u0430\u0446\u0438\u0435\u0439 \u043f\u043e \u0444\u043e\u0440\u043c\u0435 369 (<a href=\"https:\/\/sede.agenciatributaria.gob.es\/Sede\/procedimientoini\/G420.shtml\" target=\"_blank\" rel=\"nofollow noopener\">\u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430 AEAT \u043e \u0444\u043e\u0440\u043c\u0435 369<\/a>).<\/li><li>\u0421\u0430\u0439\u0442 \u043e\u043d\u043b\u0430\u0439\u043d-\u0431\u0438\u0437\u043d\u0435\u0441\u0430 \u043e\u0431\u044f\u0437\u0430\u043d \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435, \u0430\u0434\u0440\u0435\u0441, \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u0443\u044e \u043f\u043e\u0447\u0442\u0443, \u043d\u0430\u043b\u043e\u0433\u043e\u0432\u044b\u0439 \u043d\u043e\u043c\u0435\u0440 \u0438 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 \u043f\u0440\u043e\u0434\u0430\u0432\u0446\u0430 (<a href=\"https:\/\/www.boe.es\/buscar\/act.php?id=BOE-A-2002-13758#a10\" target=\"_blank\" rel=\"nofollow noopener\">\u0441\u0442\u0430\u0442\u044c\u044f 10 LSSI-CE<\/a>).<\/li><li>\u041f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u044c-\u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u044c \u0432\u043f\u0440\u0430\u0432\u0435 \u043e\u0442\u043a\u0430\u0437\u0430\u0442\u044c\u0441\u044f \u043e\u0442 \u043e\u043d\u043b\u0430\u0439\u043d-\u043f\u043e\u043a\u0443\u043f\u043a\u0438 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 14 \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u043d\u044b\u0445 \u0434\u043d\u0435\u0439 \u0431\u0435\u0437 \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u044f \u043f\u0440\u0438\u0447\u0438\u043d (<a href=\"https:\/\/www.boe.es\/buscar\/act.php?id=BOE-A-2007-20555#a102\" target=\"_blank\" rel=\"nofollow noopener\">\u0441\u0442\u0430\u0442\u044c\u044f 102 \u0417\u0430\u043a\u043e\u043d\u0430 \u043e \u0437\u0430\u0449\u0438\u0442\u0435 \u043f\u0440\u0430\u0432 \u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u0435\u0439<\/a>).<\/li><li>\u041f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u044b \u0434\u043b\u044f \u0432\u044b\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0441\u0447\u0435\u0442\u043e\u0432 \u0434\u043e\u043b\u0436\u043d\u044b \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u044f\u043c Verifactu: \u0434\u043b\u044f \u043f\u043b\u0430\u0442\u0435\u043b\u044c\u0449\u0438\u043a\u043e\u0432 \u043d\u0430\u043b\u043e\u0433\u0430 \u043d\u0430 \u043f\u0440\u0438\u0431\u044b\u043b\u044c \u0434\u043e 1 \u044f\u043d\u0432\u0430\u0440\u044f 2027 \u0433\u043e\u0434\u0430, \u0434\u043b\u044f \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0445 \u0434\u043e 1 \u0438\u044e\u043b\u044f 2027 \u0433\u043e\u0434\u0430 (<a href=\"https:\/\/www.boe.es\/buscar\/act.php?id=BOE-A-2023-24840#df-4\" target=\"_blank\" rel=\"nofollow noopener\">\u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u0438\u0439 \u0443\u043a\u0430\u0437 1007\/2023<\/a>).<\/li><\/ul><\/div><h3>\u0412\u044b \u043f\u043b\u0430\u043d\u0438\u0440\u0443\u0435\u0442\u0435 \u043f\u0440\u043e\u0434\u0430\u0432\u0430\u0442\u044c \u043e\u043d\u043b\u0430\u0439\u043d \u0438\u0437 \u0418\u0441\u043f\u0430\u043d\u0438\u0438: \u0441 \u0447\u0435\u0433\u043e \u043d\u0430\u0447\u0430\u0442\u044c?<\/h3><p>\u0418\u043d\u0442\u0435\u0440\u043d\u0435\u0442-\u043c\u0430\u0433\u0430\u0437\u0438\u043d \u0438\u043b\u0438 \u043e\u043d\u043b\u0430\u0439\u043d-\u0441\u0435\u0440\u0432\u0438\u0441 \u043c\u043e\u0436\u043d\u043e \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u044c \u0431\u044b\u0441\u0442\u0440\u043e, \u043d\u043e \u0441 \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u0434\u043d\u044f \u043f\u0440\u043e\u0434\u0430\u0436 \u043e\u043d \u043f\u043e\u0434\u0447\u0438\u043d\u044f\u0435\u0442\u0441\u044f \u0442\u0435\u043c \u0436\u0435 \u043d\u0430\u043b\u043e\u0433\u043e\u0432\u044b\u043c \u0438 \u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u043c \u043f\u0440\u0430\u0432\u0438\u043b\u0430\u043c, \u0447\u0442\u043e \u0438 \u043e\u0431\u044b\u0447\u043d\u044b\u0439 \u0431\u0438\u0437\u043d\u0435\u0441, \u0430 \u0442\u0430\u043a\u0436\u0435 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u043c \u043d\u043e\u0440\u043c\u0430\u043c \u043e\u0431 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u0439 \u0442\u043e\u0440\u0433\u043e\u0432\u043b\u0435 \u0438 \u0437\u0430\u0449\u0438\u0442\u0435 \u0434\u0430\u043d\u043d\u044b\u0445.<\/p><p>\u0414\u043b\u044f \u043f\u0440\u0435\u0434\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u0440\u043e\u0434\u0430\u0451\u0442 \u0438\u0437 \u0418\u0441\u043f\u0430\u043d\u0438\u0438, \u043a\u043b\u044e\u0447\u0435\u0432\u044b\u0435 \u0432\u043e\u043f\u0440\u043e\u0441\u044b \u043a\u0430\u0441\u0430\u044e\u0442\u0441\u044f \u0444\u043e\u0440\u043c\u044b \u0431\u0438\u0437\u043d\u0435\u0441\u0430, \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438, \u041d\u0414\u0421, \u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438 \u043d\u0430 \u0441\u0430\u0439\u0442\u0435, \u0437\u0430\u0449\u0438\u0442\u044b \u0434\u0430\u043d\u043d\u044b\u0445 \u0438 \u043f\u0440\u0430\u0432 \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u0435\u0439. \u041d\u043e\u0440\u043c\u044b \u043f\u0440\u0438\u0432\u0435\u0434\u0435\u043d\u044b \u043f\u043e \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044e \u043d\u0430 \u043e\u043a\u0442\u044f\u0431\u0440\u044c 2026 \u0433\u043e\u0434\u0430.<\/p><h2>\u0424\u043e\u0440\u043c\u0430 \u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0431\u0438\u0437\u043d\u0435\u0441\u0430: aut\u00f3nomo \u0438\u043b\u0438 SL<\/h2><p>\u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u043d\u0443\u0436\u043d\u043e \u0432\u044b\u0431\u0440\u0430\u0442\u044c \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u043e\u043d\u043d\u043e-\u043f\u0440\u0430\u0432\u043e\u0432\u0443\u044e \u0444\u043e\u0440\u043c\u0443:<\/p><ul><li><strong>\u0418\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u0440\u0435\u0434\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c (aut\u00f3nomo)<\/strong>: \u0431\u044b\u0441\u0442\u0440\u0430\u044f \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044f, \u043d\u0430\u043b\u043e\u0433 \u043d\u0430 \u0434\u043e\u0445\u043e\u0434\u044b \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043b\u0438\u0446 (IRPF), \u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0432\u0441\u0435\u043c \u043b\u0438\u0447\u043d\u044b\u043c \u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u043c (<a href=\"https:\/\/www.boe.es\/buscar\/act.php?id=BOE-A-1889-4763#art1911\" target=\"_blank\" rel=\"nofollow noopener\">\u0441\u0442\u0430\u0442\u044c\u044f 1911 \u0413\u0440\u0430\u0436\u0434\u0430\u043d\u0441\u043a\u043e\u0433\u043e \u043a\u043e\u0434\u0435\u043a\u0441\u0430<\/a>).<\/li><li><strong>\u041e\u0431\u0449\u0435\u0441\u0442\u0432\u043e \u0441 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u043e\u0439 \u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c\u044e (Sociedad Limitada, SL)<\/strong>: \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u044b\u0439 \u043a\u0430\u043f\u0438\u0442\u0430\u043b 1 \u0435\u0432\u0440\u043e (<a href=\"https:\/\/www.boe.es\/buscar\/act.php?id=BOE-A-2010-10544#a4\" target=\"_blank\" rel=\"nofollow noopener\">\u0441\u0442\u0430\u0442\u044c\u044f 4 \u0417\u0430\u043a\u043e\u043d\u0430 \u043e \u043a\u0430\u043f\u0438\u0442\u0430\u043b\u044c\u043d\u044b\u0445 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430\u0445<\/a>), \u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u043e\u0432 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0430 \u0432\u043a\u043b\u0430\u0434\u043e\u043c, \u043f\u0440\u0438\u0431\u044b\u043b\u044c \u043e\u0431\u043b\u0430\u0433\u0430\u0435\u0442\u0441\u044f \u043d\u0430\u043b\u043e\u0433\u043e\u043c \u043d\u0430 \u043f\u0440\u0438\u0431\u044b\u043b\u044c \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0439.<\/li><li><strong>\u0410\u043a\u0446\u0438\u043e\u043d\u0435\u0440\u043d\u043e\u0435 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e (Sociedad An\u00f3nima, SA)<\/strong>: \u043a\u0430\u043f\u0438\u0442\u0430\u043b \u043e\u0442 60 000 \u0435\u0432\u0440\u043e, \u043f\u043e\u0434\u0445\u043e\u0434\u0438\u0442 \u0434\u043b\u044f \u043a\u0440\u0443\u043f\u043d\u044b\u0445 \u043f\u0440\u043e\u0435\u043a\u0442\u043e\u0432.<\/li><\/ul><p>\u0421\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435 \u0444\u043e\u0440\u043c \u0438 \u043f\u043e\u0440\u044f\u0434\u043e\u043a \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f SL \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e \u043e\u043f\u0438\u0441\u0430\u043d\u044b \u0432 <a href=\"https:\/\/delaguialuzon.com\/ru\/blog\/%d0%ba%d0%b0%d0%ba-%d1%83%d1%87%d1%80%d0%b5%d0%b4%d0%b8%d1%82%d1%8c-%d1%81%d1%82%d0%b0%d1%80%d1%82%d0%b0%d0%bf-%d0%b2-%d0%b8%d1%81%d0%bf%d0%b0%d0%bd%d0%b8%d0%b8\/\">\u0440\u0443\u043a\u043e\u0432\u043e\u0434\u0441\u0442\u0432\u0435 \u043f\u043e \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044e \u0441\u0442\u0430\u0440\u0442\u0430\u043f\u0430 \u0432 \u0418\u0441\u043f\u0430\u043d\u0438\u0438<\/a>. \u0415\u0441\u043b\u0438 \u043f\u0440\u043e\u0435\u043a\u0442\u0443 \u043d\u0443\u0436\u043d\u044b \u0438\u043d\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u0438, \u043f\u043e\u043b\u0435\u0437\u043d\u043e \u0437\u0430\u0440\u0430\u043d\u0435\u0435 \u0438\u0437\u0443\u0447\u0438\u0442\u044c <a href=\"https:\/\/delaguialuzon.com\/ru\/blog\/%d1%81%d1%82%d1%80%d0%b0%d1%82%d0%b5%d0%b3%d0%b8%d0%b8-%d1%84%d0%b8%d0%bd%d0%b0%d0%bd%d1%81%d0%b8%d1%80%d0%be%d0%b2%d0%b0%d0%bd%d0%b8%d0%b5-%d1%81%d1%82%d0%b0%d1%80%d1%82%d0%b0%d0%bf%d1%8b\/\">\u0432\u0430\u0440\u0438\u0430\u043d\u0442\u044b \u0444\u0438\u043d\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0441\u0442\u0430\u0440\u0442\u0430\u043f\u043e\u0432<\/a>.<\/p><h2>\u0420\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044f \u0432 \u043d\u0430\u043b\u043e\u0433\u043e\u0432\u043e\u0439 \u0441\u043b\u0443\u0436\u0431\u0435 \u0438 \u0421\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u043c \u0441\u0442\u0440\u0430\u0445\u043e\u0432\u0430\u043d\u0438\u0438<\/h2><p>\u0414\u043e \u043d\u0430\u0447\u0430\u043b\u0430 \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u0435\u0434\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c \u0438\u043b\u0438 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u044f \u043f\u043e\u0434\u0430\u0451\u0442 \u0432 \u043d\u0430\u043b\u043e\u0433\u043e\u0432\u0443\u044e \u0441\u043b\u0443\u0436\u0431\u0443 (Agencia Tributaria, AEAT) \u0434\u0435\u043a\u043b\u0430\u0440\u0430\u0446\u0438\u044e \u043e \u043f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0435 \u043d\u0430 \u043d\u0430\u043b\u043e\u0433\u043e\u0432\u044b\u0439 \u0443\u0447\u0451\u0442 (declaraci\u00f3n censal). \u041a\u043e\u043c\u043f\u0430\u043d\u0438\u044f \u0437\u0430\u043f\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442 \u043d\u0430\u043b\u043e\u0433\u043e\u0432\u044b\u0439 \u043d\u043e\u043c\u0435\u0440 NIF \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u043c\u0435\u0441\u044f\u0446\u0430 \u043f\u043e\u0441\u043b\u0435 \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f (<a href=\"https:\/\/www.boe.es\/buscar\/act.php?id=BOE-A-2007-15984#a23\" target=\"_blank\" rel=\"nofollow noopener\">\u0441\u0442\u0430\u0442\u044c\u044f 23 \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u043e\u0433\u043e \u0443\u043a\u0430\u0437\u0430 1065\/2007<\/a>).<\/p><p>\u0418\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u044b\u0439 \u043f\u0440\u0435\u0434\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c \u0442\u0430\u043a\u0436\u0435 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u0432 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u043c \u0440\u0435\u0436\u0438\u043c\u0435 \u0421\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0441\u0442\u0440\u0430\u0445\u043e\u0432\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u0441\u0430\u043c\u043e\u0437\u0430\u043d\u044f\u0442\u044b\u0445 (RETA). \u0412\u0437\u043d\u043e\u0441\u044b \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044b\u0432\u0430\u044e\u0442\u0441\u044f \u0438\u0441\u0445\u043e\u0434\u044f \u0438\u0437 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u0447\u0438\u0441\u0442\u043e\u0433\u043e \u0434\u043e\u0445\u043e\u0434\u0430; \u0430\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u0443\u044e \u0448\u043a\u0430\u043b\u0443 \u043f\u0443\u0431\u043b\u0438\u043a\u0443\u0435\u0442 <a href=\"https:\/\/www.seg-social.es\/wps\/portal\/wss\/internet\/HerramientasWeb\/9d2fd4f1-ab0f-42a6-8d10-2e74b378ee24\" target=\"_blank\" rel=\"nofollow noopener\">\u0421\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0435 \u0441\u0442\u0440\u0430\u0445\u043e\u0432\u0430\u043d\u0438\u0435 (Seguridad Social)<\/a>. \u041e \u0442\u0435\u043a\u0443\u0449\u0438\u0445 \u043c\u0435\u0440\u0430\u0445 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0438 \u0441\u0430\u043c\u043e\u0437\u0430\u043d\u044f\u0442\u044b\u0445 \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u0430\u043d\u043e \u0432 <a href=\"https:\/\/delaguialuzon.com\/ru\/blog\/%d1%81%d1%83%d0%b1%d1%81%d0%b8%d0%b4%d0%b8%d0%b8-%d0%b4%d0%bb%d1%8f-%d1%81%d0%b0%d0%bc%d0%be%d0%b7%d0%b0%d0%bd%d1%8f%d1%82%d1%8b%d1%85\/\">\u0441\u0442\u0430\u0442\u044c\u0435 \u043e \u0441\u0443\u0431\u0441\u0438\u0434\u0438\u044f\u0445 \u0434\u043b\u044f \u0441\u0430\u043c\u043e\u0437\u0430\u043d\u044f\u0442\u044b\u0445 \u0432 2026 \u0433\u043e\u0434\u0443<\/a>.<\/p><p>\u041e\u043d\u043b\u0430\u0439\u043d-\u0431\u0438\u0437\u043d\u0435\u0441 \u043e\u0431\u044f\u0437\u0430\u043d \u0432\u0435\u0441\u0442\u0438 \u0431\u0443\u0445\u0433\u0430\u043b\u0442\u0435\u0440\u0441\u043a\u0438\u0439 \u0438\u043b\u0438 \u043d\u0430\u043b\u043e\u0433\u043e\u0432\u044b\u0439 \u0443\u0447\u0451\u0442 \u0438 \u0440\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u043e \u043f\u043e\u0434\u0430\u0432\u0430\u0442\u044c \u0434\u0435\u043a\u043b\u0430\u0440\u0430\u0446\u0438\u0438 \u043f\u043e \u041d\u0414\u0421 \u0438 \u043d\u0430\u043b\u043e\u0433\u0443 \u043d\u0430 \u0434\u043e\u0445\u043e\u0434\u044b. \u041c\u043d\u043e\u0433\u0438\u0435 \u043f\u0440\u0435\u0434\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u0438 \u043f\u0435\u0440\u0435\u0434\u0430\u044e\u0442 \u044d\u0442\u0443 \u0440\u0430\u0431\u043e\u0442\u0443 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u0443; \u043e \u0442\u043e\u043c, \u043a\u0430\u043a \u0435\u0433\u043e \u0432\u044b\u0431\u0440\u0430\u0442\u044c, \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u0430\u043d\u043e \u0432 <a href=\"https:\/\/delaguialuzon.com\/ru\/blog\/%d0%bd%d0%b0%d0%bd%d1%8f%d1%82%d1%8c-%d0%ba%d0%be%d0%bd%d1%81%d1%83%d0%bb%d1%8c%d1%82%d0%b0%d0%bd%d1%82%d0%b0-%d0%b1%d1%83%d1%85%d0%b3%d0%b0%d0%bb%d1%82%d0%b5%d1%80%d0%b0\/\">\u0441\u0442\u0430\u0442\u044c\u0435 \u043e \u0431\u0443\u0445\u0433\u0430\u043b\u0442\u0435\u0440\u0435 \u0432 \u0418\u0441\u043f\u0430\u043d\u0438\u0438<\/a>.<\/p><h2>\u041d\u0414\u0421 \u043f\u0440\u0438 \u043e\u043d\u043b\u0430\u0439\u043d-\u043f\u0440\u043e\u0434\u0430\u0436\u0430\u0445<\/h2><p>\u041f\u0440\u043e\u0434\u0430\u0436\u0438 \u0432 \u0418\u0441\u043f\u0430\u043d\u0438\u0438 \u043e\u0431\u043b\u0430\u0433\u0430\u044e\u0442\u0441\u044f \u041d\u0414\u0421 (IVA) \u043f\u043e \u043e\u0431\u0449\u0435\u0439 \u0441\u0442\u0430\u0432\u043a\u0435 21%; \u0434\u043b\u044f \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0445 \u0442\u043e\u0432\u0430\u0440\u043e\u0432 \u0438 \u0443\u0441\u043b\u0443\u0433 \u0437\u0430\u043a\u043e\u043d \u043f\u0440\u0435\u0434\u0443\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442 \u043f\u043e\u043d\u0438\u0436\u0435\u043d\u043d\u044b\u0435 \u0441\u0442\u0430\u0432\u043a\u0438 (<a href=\"https:\/\/www.boe.es\/buscar\/act.php?id=BOE-A-1992-28740#a90\" target=\"_blank\" rel=\"nofollow noopener\">\u0441\u0442\u0430\u0442\u044c\u044f 90 \u0417\u0430\u043a\u043e\u043d\u0430 \u043e\u0431 \u041d\u0414\u0421<\/a>).<\/p><p>\u0414\u043b\u044f \u043f\u0440\u043e\u0434\u0430\u0436 \u0447\u0430\u0441\u0442\u043d\u044b\u043c \u043b\u0438\u0446\u0430\u043c \u0432 \u0434\u0440\u0443\u0433\u0438\u0445 \u0441\u0442\u0440\u0430\u043d\u0430\u0445 \u0415\u0421 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044e\u0442 \u043e\u0441\u043e\u0431\u044b\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u0430:<\/p><table><thead><tr><th>\u0421\u0438\u0442\u0443\u0430\u0446\u0438\u044f<\/th><th>\u0413\u0434\u0435 \u0443\u043f\u043b\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u041d\u0414\u0421<\/th><\/tr><\/thead><tbody><tr><td>\u0414\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u044b\u0435 \u043f\u0440\u043e\u0434\u0430\u0436\u0438 \u0442\u043e\u0432\u0430\u0440\u043e\u0432 \u0438 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u044b\u0435 \u0443\u0441\u043b\u0443\u0433\u0438 \u0447\u0430\u0441\u0442\u043d\u044b\u043c \u043b\u0438\u0446\u0430\u043c \u0432 \u0415\u0421 \u043d\u0430 \u0441\u0443\u043c\u043c\u0443 \u0434\u043e 10 000 \u0435\u0432\u0440\u043e \u0432 \u0433\u043e\u0434 (\u0431\u0435\u0437 \u041d\u0414\u0421), \u0435\u0441\u043b\u0438 \u043f\u0440\u043e\u0434\u0430\u0432\u0435\u0446 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u0438\u0437 \u0418\u0441\u043f\u0430\u043d\u0438\u0438<\/td><td>\u0412 \u0418\u0441\u043f\u0430\u043d\u0438\u0438, \u043f\u043e \u0438\u0441\u043f\u0430\u043d\u0441\u043a\u043e\u0439 \u0441\u0442\u0430\u0432\u043a\u0435 (\u0435\u0441\u043b\u0438 \u043f\u0440\u043e\u0434\u0430\u0432\u0435\u0446 \u043d\u0435 \u0432\u044b\u0431\u0440\u0430\u043b \u0438\u043d\u043e\u0435)<\/td><\/tr><tr><td>\u0422\u0435 \u0436\u0435 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u0441\u0432\u044b\u0448\u0435 10 000 \u0435\u0432\u0440\u043e \u0432 \u0433\u043e\u0434<\/td><td>\u0412 \u0441\u0442\u0440\u0430\u043d\u0435 \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u044f, \u043f\u043e \u0441\u0442\u0430\u0432\u043a\u0435 \u044d\u0442\u043e\u0439 \u0441\u0442\u0440\u0430\u043d\u044b<\/td><\/tr><\/tbody><\/table><p>\u041f\u043e\u0440\u043e\u0433 \u0432 10 000 \u0435\u0432\u0440\u043e \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f \u043f\u043e \u0432\u0441\u0435\u043c \u0441\u0442\u0440\u0430\u043d\u0430\u043c \u0415\u0421 \u0432\u043c\u0435\u0441\u0442\u0435 \u0437\u0430 \u043f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0438\u0439 \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u043d\u044b\u0439 \u0433\u043e\u0434; \u0435\u0441\u043b\u0438 \u043e\u043d \u043f\u0440\u0435\u0432\u044b\u0448\u0435\u043d \u0432 \u0442\u0435\u043a\u0443\u0449\u0435\u043c \u0433\u043e\u0434\u0443, \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u0441\u0442\u0440\u0430\u043d\u044b \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u044f \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u044e\u0442\u0441\u044f \u0443\u0436\u0435 \u0441 \u044d\u0442\u043e\u0433\u043e \u043c\u043e\u043c\u0435\u043d\u0442\u0430 (<a href=\"https:\/\/www.boe.es\/buscar\/act.php?id=BOE-A-1992-28740#a73\" target=\"_blank\" rel=\"nofollow noopener\">\u0441\u0442\u0430\u0442\u044c\u044f 73 \u0417\u0430\u043a\u043e\u043d\u0430 \u043e\u0431 \u041d\u0414\u0421<\/a>).<\/p><p>\u0427\u0442\u043e\u0431\u044b \u043d\u0435 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u0432 \u043a\u0430\u0436\u0434\u043e\u0439 \u0441\u0442\u0440\u0430\u043d\u0435 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e, \u043c\u043e\u0436\u043d\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0435\u0434\u0438\u043d\u043e\u0435 \u043e\u043a\u043d\u043e OSS (\u0440\u0435\u0436\u0438\u043c \u0421\u043e\u044e\u0437\u0430). \u041f\u0440\u043e\u0434\u0430\u0432\u0435\u0446, \u0437\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u0432 \u0418\u0441\u043f\u0430\u043d\u0438\u0438, \u043f\u043e\u0434\u0430\u0451\u0442 \u0432 AEAT \u043e\u0434\u043d\u0443 \u0434\u0435\u043a\u043b\u0430\u0440\u0430\u0446\u0438\u044e \u043f\u043e \u0444\u043e\u0440\u043c\u0435 369 \u0437\u0430 \u043a\u0430\u0436\u0434\u044b\u0439 \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u043d\u044b\u0439 \u043a\u0432\u0430\u0440\u0442\u0430\u043b \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u043c\u0435\u0441\u044f\u0446\u0430 \u043f\u043e\u0441\u043b\u0435 \u0435\u0433\u043e \u043e\u043a\u043e\u043d\u0447\u0430\u043d\u0438\u044f (<a href=\"https:\/\/www.boe.es\/buscar\/act.php?id=BOE-A-1992-28740#a163duovicies\" target=\"_blank\" rel=\"nofollow noopener\">\u0441\u0442\u0430\u0442\u044c\u044f 163 duovicies \u0417\u0430\u043a\u043e\u043d\u0430 \u043e\u0431 \u041d\u0414\u0421<\/a>; <a href=\"https:\/\/sede.agenciatributaria.gob.es\/Sede\/procedimientoini\/G420.shtml\" target=\"_blank\" rel=\"nofollow noopener\">\u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430 AEAT \u043e \u0444\u043e\u0440\u043c\u0435 369<\/a>).<\/p><p>\u041f\u0440\u043e\u0434\u0430\u0436\u0438 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u044f\u043c (B2B), \u043f\u0440\u043e\u0434\u0430\u0436\u0438 \u0437\u0430 \u043f\u0440\u0435\u0434\u0435\u043b\u044b \u0415\u0421 \u0438 \u043c\u0430\u0440\u043a\u0435\u0442\u043f\u043b\u0435\u0439\u0441\u044b \u043f\u043e\u0434\u0447\u0438\u043d\u044f\u044e\u0442\u0441\u044f \u0434\u0440\u0443\u0433\u0438\u043c \u043f\u0440\u0430\u0432\u0438\u043b\u0430\u043c. \u0415\u0441\u043b\u0438 \u0412\u0430\u0448\u0430 \u043c\u043e\u0434\u0435\u043b\u044c \u043f\u0440\u043e\u0434\u0430\u0436 \u043d\u0435 \u0443\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0432 \u043e\u043f\u0438\u0441\u0430\u043d\u043d\u0443\u044e \u0441\u0445\u0435\u043c\u0443, <a href=\"https:\/\/delaguialuzon.com\/ru\/%d0%ba%d0%be%d0%bd%d1%82%d0%b0%d0%ba%d1%82%d1%8b\/\">\u0441\u0432\u044f\u0436\u0438\u0442\u0435\u0441\u044c \u0441 \u043d\u0430\u043c\u0438<\/a> \u0434\u043b\u044f \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438 \u043d\u0430\u043b\u043e\u0433\u043e\u043e\u0431\u043b\u043e\u0436\u0435\u043d\u0438\u044f.<\/p><h2>\u0422\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u044f LSSI-CE \u043a \u0441\u0430\u0439\u0442\u0443<\/h2><p>\u0417\u0430\u043a\u043e\u043d \u043e\u0431 \u0443\u0441\u043b\u0443\u0433\u0430\u0445 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430 \u0438 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u0439 \u0442\u043e\u0440\u0433\u043e\u0432\u043b\u0435 (<a href=\"https:\/\/www.boe.es\/buscar\/act.php?id=BOE-A-2002-13758\" target=\"_blank\" rel=\"nofollow noopener\">Ley 34\/2002, LSSI-CE<\/a>) \u043e\u0431\u044f\u0437\u044b\u0432\u0430\u0435\u0442 \u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u0430 \u0441\u0430\u0439\u0442\u0430 \u043e\u0431\u0435\u0441\u043f\u0435\u0447\u0438\u0442\u044c \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u0439, \u043f\u0440\u043e\u0441\u0442\u043e\u0439 \u0438 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u044b\u0439 \u0434\u043e\u0441\u0442\u0443\u043f \u043a \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u043c \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u044f\u043c (<a href=\"https:\/\/www.boe.es\/buscar\/act.php?id=BOE-A-2002-13758#a10\" target=\"_blank\" rel=\"nofollow noopener\">\u0441\u0442\u0430\u0442\u044c\u044f 10<\/a>):<\/p><ul><li>\u043d\u0430\u0438\u043c\u0435\u043d\u043e\u0432\u0430\u043d\u0438\u0435, \u0430\u0434\u0440\u0435\u0441 \u0438 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u0430\u044f \u043f\u043e\u0447\u0442\u0430;<\/li><li>\u0434\u0430\u043d\u043d\u044b\u0435 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438 \u0432 \u0422\u043e\u0440\u0433\u043e\u0432\u043e\u043c \u0440\u0435\u0435\u0441\u0442\u0440\u0435 (\u0435\u0441\u043b\u0438 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u044f \u0437\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0430);<\/li><li>\u043d\u0430\u043b\u043e\u0433\u043e\u0432\u044b\u0439 \u043d\u043e\u043c\u0435\u0440 (NIF);<\/li><li>\u044f\u0441\u043d\u0430\u044f \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f \u043e \u0446\u0435\u043d\u0435, \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u044b \u043b\u0438 \u0432 \u043d\u0435\u0451 \u043d\u0430\u043b\u043e\u0433\u0438 \u0438 \u0441\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u044c \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0438;<\/li><li>\u0441\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043e \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u0438 \u0438 \u043d\u0430\u0434\u0437\u043e\u0440\u043d\u043e\u043c \u043e\u0440\u0433\u0430\u043d\u0435, \u0435\u0441\u043b\u0438 \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043b\u0438\u0446\u0435\u043d\u0437\u0438\u0440\u0443\u0435\u0442\u0441\u044f.<\/li><\/ul><p>\u0420\u0435\u043a\u043b\u0430\u043c\u043d\u044b\u0435 \u0440\u0430\u0441\u0441\u044b\u043b\u043a\u0438 \u043f\u043e \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u0439 \u043f\u043e\u0447\u0442\u0435 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u044b \u0442\u043e\u043b\u044c\u043a\u043e \u0441 \u043f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u0441\u043e\u0433\u043b\u0430\u0441\u0438\u044f \u043f\u043e\u043b\u0443\u0447\u0430\u0442\u0435\u043b\u044f \u0438\u043b\u0438 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u043c \u043a\u043b\u0438\u0435\u043d\u0442\u0430\u043c \u043e \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0430\u043d\u0430\u043b\u043e\u0433\u0438\u0447\u043d\u044b\u0445 \u0442\u043e\u0432\u0430\u0440\u0430\u0445; \u0432 \u043a\u0430\u0436\u0434\u043e\u043c \u043f\u0438\u0441\u044c\u043c\u0435 \u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u044b\u0442\u044c \u043f\u0440\u043e\u0441\u0442\u0430\u044f \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u043e\u0442\u043f\u0438\u0441\u0430\u0442\u044c\u0441\u044f (<a href=\"https:\/\/www.boe.es\/buscar\/act.php?id=BOE-A-2002-13758#a21\" target=\"_blank\" rel=\"nofollow noopener\">\u0441\u0442\u0430\u0442\u044c\u044f 21<\/a>).<\/p><p>\u0424\u0430\u0439\u043b\u044b cookie, \u043a\u0440\u043e\u043c\u0435 \u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u044b\u0445, \u043c\u043e\u0436\u043d\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u0441\u043b\u0435 \u0441\u043e\u0433\u043b\u0430\u0441\u0438\u044f \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f, \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u043d\u043e\u0433\u043e \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u044f\u0441\u043d\u043e\u0439 \u0438 \u043f\u043e\u043b\u043d\u043e\u0439 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438 (<a href=\"https:\/\/www.boe.es\/buscar\/act.php?id=BOE-A-2002-13758#a22\" target=\"_blank\" rel=\"nofollow noopener\">\u0441\u0442\u0430\u0442\u044c\u044f 22.2<\/a>).<\/p><h2>\u0417\u0430\u0449\u0438\u0442\u0430 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0445 \u0434\u0430\u043d\u043d\u044b\u0445: RGPD \u0438 LOPDGDD<\/h2><p>\u041b\u044e\u0431\u043e\u0439 \u043e\u043d\u043b\u0430\u0439\u043d-\u0431\u0438\u0437\u043d\u0435\u0441 \u043e\u0431\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0435\u0442 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 \u043a\u043b\u0438\u0435\u043d\u0442\u043e\u0432: \u0438\u043c\u0435\u043d\u0430, \u0430\u0434\u0440\u0435\u0441\u0430, \u043f\u043b\u0430\u0442\u0451\u0436\u043d\u044b\u0435 \u0434\u0430\u043d\u043d\u044b\u0435. \u042d\u0442\u0430 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0430 \u043f\u043e\u0434\u0447\u0438\u043d\u044f\u0435\u0442\u0441\u044f <a href=\"https:\/\/www.boe.es\/buscar\/doc.php?id=DOUE-L-2016-80807\" target=\"_blank\" rel=\"nofollow noopener\">\u041e\u0431\u0449\u0435\u043c\u0443 \u0440\u0435\u0433\u043b\u0430\u043c\u0435\u043d\u0442\u0443 \u0415\u0421 \u043f\u043e \u0437\u0430\u0449\u0438\u0442\u0435 \u0434\u0430\u043d\u043d\u044b\u0445 (RGPD)<\/a> \u0438 \u0438\u0441\u043f\u0430\u043d\u0441\u043a\u043e\u043c\u0443 <a href=\"https:\/\/www.boe.es\/buscar\/act.php?id=BOE-A-2018-16673\" target=\"_blank\" rel=\"nofollow noopener\">\u041e\u0440\u0433\u0430\u043d\u0438\u0447\u0435\u0441\u043a\u043e\u043c\u0443 \u0437\u0430\u043a\u043e\u043d\u0443 3\/2018 (LOPDGDD)<\/a>.<\/p><p>\u041d\u0430 \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0435 \u044d\u0442\u043e \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442 \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0443 \u043a\u043e\u043d\u0444\u0438\u0434\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u043d\u0430 \u0441\u0430\u0439\u0442\u0435, \u043f\u0440\u0430\u0432\u043e\u0432\u043e\u0435 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435 \u0434\u043b\u044f \u043a\u0430\u0436\u0434\u043e\u0439 \u0446\u0435\u043b\u0438 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0438, \u0434\u043e\u0433\u043e\u0432\u043e\u0440\u044b \u0441 \u043f\u043e\u0434\u0440\u044f\u0434\u0447\u0438\u043a\u0430\u043c\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u043e\u043b\u0443\u0447\u0430\u044e\u0442 \u0434\u043e\u0441\u0442\u0443\u043f \u043a \u0434\u0430\u043d\u043d\u044b\u043c (\u0445\u043e\u0441\u0442\u0438\u043d\u0433, \u043f\u043b\u0430\u0442\u0451\u0436\u043d\u044b\u0435 \u0438 \u043f\u043e\u0447\u0442\u043e\u0432\u044b\u0435 \u0441\u0435\u0440\u0432\u0438\u0441\u044b), \u0438 \u043c\u0435\u0440\u044b \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438. \u041e\u0431\u044a\u0451\u043c \u043e\u0431\u044f\u0437\u0430\u043d\u043d\u043e\u0441\u0442\u0435\u0439 \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u0442\u043e\u0433\u043e, \u043a\u0430\u043a\u0438\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 \u0438 \u0432 \u043a\u0430\u043a\u043e\u043c \u043e\u0431\u044a\u0451\u043c\u0435 \u0412\u044b \u043e\u0431\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0435\u0442\u0435.<\/p><h2>\u041f\u0440\u0430\u0432\u0430 \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u0435\u0439: \u043e\u0442\u043a\u0430\u0437 \u043e\u0442 \u043f\u043e\u043a\u0443\u043f\u043a\u0438<\/h2><p>\u041f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u044c, \u043a\u0443\u043f\u0438\u0432\u0448\u0438\u0439 \u0442\u043e\u0432\u0430\u0440 \u0438\u043b\u0438 \u0443\u0441\u043b\u0443\u0433\u0443 \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e, \u043c\u043e\u0436\u0435\u0442 \u043e\u0442\u043a\u0430\u0437\u0430\u0442\u044c\u0441\u044f \u043e\u0442 \u0434\u043e\u0433\u043e\u0432\u043e\u0440\u0430 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 14 \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u043d\u044b\u0445 \u0434\u043d\u0435\u0439 \u0431\u0435\u0437 \u043e\u0431\u044a\u044f\u0441\u043d\u0435\u043d\u0438\u044f \u043f\u0440\u0438\u0447\u0438\u043d (<a href=\"https:\/\/www.boe.es\/buscar\/act.php?id=BOE-A-2007-20555#a102\" target=\"_blank\" rel=\"nofollow noopener\">\u0441\u0442\u0430\u0442\u044c\u044f 102 \u0417\u0430\u043a\u043e\u043d\u0430 \u043e \u0437\u0430\u0449\u0438\u0442\u0435 \u043f\u0440\u0430\u0432 \u043f\u043e\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043b\u0435\u0439<\/a>). \u0414\u043b\u044f \u0442\u043e\u0432\u0430\u0440\u043e\u0432 \u0441\u0440\u043e\u043a \u043e\u0431\u044b\u0447\u043d\u043e \u043e\u0442\u0441\u0447\u0438\u0442\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0441 \u043c\u043e\u043c\u0435\u043d\u0442\u0430, \u043a\u043e\u0433\u0434\u0430 \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u044c \u043f\u043e\u043b\u0443\u0447\u0438\u043b \u0442\u043e\u0432\u0430\u0440, \u0434\u043b\u044f \u0443\u0441\u043b\u0443\u0433 \u0441\u043e \u0434\u043d\u044f \u0437\u0430\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0434\u043e\u0433\u043e\u0432\u043e\u0440\u0430 (<a href=\"https:\/\/www.boe.es\/buscar\/act.php?id=BOE-A-2007-20555#a104\" target=\"_blank\" rel=\"nofollow noopener\">\u0441\u0442\u0430\u0442\u044c\u044f 104<\/a>).<\/p><p>\u0417\u0430\u043a\u043e\u043d \u043f\u0440\u0435\u0434\u0443\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 \u0434\u043b\u044f \u0442\u043e\u0432\u0430\u0440\u043e\u0432, \u0438\u0437\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u043d\u044b\u0445 \u043f\u043e \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u043e\u043c\u0443 \u0437\u0430\u043a\u0430\u0437\u0443 \u0438\u043b\u0438 \u044f\u0432\u043d\u043e \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 (<a href=\"https:\/\/www.boe.es\/buscar\/act.php?id=BOE-A-2007-20555#a103\" target=\"_blank\" rel=\"nofollow noopener\">\u0441\u0442\u0430\u0442\u044c\u044f 103<\/a>). \u0423\u0441\u043b\u043e\u0432\u0438\u044f \u043f\u0440\u043e\u0434\u0430\u0436\u0438 \u043d\u0430 \u0441\u0430\u0439\u0442\u0435 \u0434\u043e\u043b\u0436\u043d\u044b \u0447\u0451\u0442\u043a\u043e \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c \u043f\u043e\u0440\u044f\u0434\u043e\u043a \u043e\u0442\u043a\u0430\u0437\u0430.<\/p><h2>Verifactu: \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u044f \u043a \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430\u043c \u0432\u044b\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0441\u0447\u0435\u0442\u043e\u0432<\/h2><p><a href=\"https:\/\/www.boe.es\/buscar\/act.php?id=BOE-A-2023-24840\" target=\"_blank\" rel=\"nofollow noopener\">\u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u0438\u0439 \u0443\u043a\u0430\u0437 1007\/2023<\/a> \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u044f \u043a \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0430\u043c, \u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0432\u044b\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u0441\u0447\u0435\u0442\u0430 (\u0441\u0438\u0441\u0442\u0435\u043c\u0430 Verifactu). \u0421\u0440\u043e\u043a\u0438 \u0430\u0434\u0430\u043f\u0442\u0430\u0446\u0438\u0438 \u043f\u043e\u0441\u043b\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439 2025 \u0433\u043e\u0434\u0430 (<a href=\"https:\/\/www.boe.es\/buscar\/act.php?id=BOE-A-2023-24840#df-4\" target=\"_blank\" rel=\"nofollow noopener\">\u0437\u0430\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 4<\/a>):<\/p><ul><li>\u043f\u043b\u0430\u0442\u0435\u043b\u044c\u0449\u0438\u043a\u0438 \u043d\u0430\u043b\u043e\u0433\u0430 \u043d\u0430 \u043f\u0440\u0438\u0431\u044b\u043b\u044c \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u0430\u0446\u0438\u0439: \u0434\u043e 1 \u044f\u043d\u0432\u0430\u0440\u044f 2027 \u0433\u043e\u0434\u0430;<\/li><li>\u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u0435 \u043e\u0431\u044f\u0437\u0430\u043d\u043d\u044b\u0435 \u043b\u0438\u0446\u0430, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u044b\u0445 \u043f\u0440\u0435\u0434\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u0435\u0439: \u0434\u043e 1 \u0438\u044e\u043b\u044f 2027 \u0433\u043e\u0434\u0430.<\/li><\/ul><p>\u041f\u0440\u0438 \u0432\u044b\u0431\u043e\u0440\u0435 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u044b \u0434\u043b\u044f \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442-\u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0430 \u0438\u043b\u0438 \u0431\u0443\u0445\u0433\u0430\u043b\u0442\u0435\u0440\u0441\u043a\u043e\u0439 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u044b \u0441\u0442\u043e\u0438\u0442 \u0437\u0430\u0440\u0430\u043d\u0435\u0435 \u0443\u0442\u043e\u0447\u043d\u0438\u0442\u044c \u0443 \u043f\u043e\u0441\u0442\u0430\u0432\u0449\u0438\u043a\u0430, \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u043b\u0438 \u043e\u043d\u0430 \u044d\u0442\u0438\u043c \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u044f\u043c.<\/p><h2>\u041f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0432\u043e\u043f\u0440\u043e\u0441\u044b: \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430, \u043f\u043b\u0430\u0442\u0435\u0436\u0438, \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0430<\/h2><p>\u041f\u043e\u043c\u0438\u043c\u043e \u044e\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u0439, \u0443\u0441\u043f\u0435\u0445 \u043e\u043d\u043b\u0430\u0439\u043d-\u0431\u0438\u0437\u043d\u0435\u0441\u0430 \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0440\u0435\u0448\u0435\u043d\u0438\u0439:<\/p><ul><li><strong>\u041f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430.<\/strong> \u0412\u044b\u0431\u0438\u0440\u0430\u0439\u0442\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u0438\u0441\u043f\u0430\u043d\u0441\u043a\u0438\u0435 \u0438 \u0435\u0432\u0440\u043e\u043f\u0435\u0439\u0441\u043a\u0438\u0435 \u043d\u0430\u043b\u043e\u0433\u043e\u0432\u044b\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0438 \u0432\u044b\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0441\u0447\u0435\u0442\u043e\u0432.<\/li><li><strong>\u041f\u043b\u0430\u0442\u0435\u0436\u0438.<\/strong> \u0418\u0441\u043f\u0430\u043d\u0441\u043a\u0438\u0435 \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u0438 \u043f\u0440\u0438\u0432\u044b\u043a\u043b\u0438 \u043a \u0431\u0430\u043d\u043a\u043e\u0432\u0441\u043a\u0438\u043c \u043a\u0430\u0440\u0442\u0430\u043c \u0438 \u043c\u0435\u0441\u0442\u043d\u043e\u043c\u0443 \u0441\u0435\u0440\u0432\u0438\u0441\u0443 \u043c\u0433\u043d\u043e\u0432\u0435\u043d\u043d\u044b\u0445 \u043f\u043b\u0430\u0442\u0435\u0436\u0435\u0439 Bizum.<\/li><li><strong>\u0414\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u0438 \u0432\u043e\u0437\u0432\u0440\u0430\u0442\u044b.<\/strong> \u041b\u043e\u0433\u0438\u0441\u0442\u0438\u043a\u0430 \u0434\u043e\u043b\u0436\u043d\u0430 \u0443\u0447\u0438\u0442\u044b\u0432\u0430\u0442\u044c 14-\u0434\u043d\u0435\u0432\u043d\u044b\u0439 \u0441\u0440\u043e\u043a \u043e\u0442\u043a\u0430\u0437\u0430 \u043e\u0442 \u043f\u043e\u043a\u0443\u043f\u043a\u0438.<\/li><li><strong>\u0418\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0440\u044b\u043d\u043a\u0430.<\/strong> \u0414\u043e \u0437\u0430\u043f\u0443\u0441\u043a\u0430 \u0441\u0442\u043e\u0438\u0442 \u0438\u0437\u0443\u0447\u0438\u0442\u044c \u0441\u043f\u0440\u043e\u0441 \u0438 \u043a\u043e\u043d\u043a\u0443\u0440\u0435\u043d\u0442\u043e\u0432 \u0432 \u0412\u0430\u0448\u0435\u043c \u0441\u0435\u0433\u043c\u0435\u043d\u0442\u0435.<\/li><\/ul><p>\u0415\u0441\u043b\u0438 \u0412\u044b \u043f\u043b\u0430\u043d\u0438\u0440\u0443\u0435\u0442\u0435 \u043d\u0430\u043d\u0438\u043c\u0430\u0442\u044c \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u043e\u0432, \u043f\u043e\u043d\u0430\u0434\u043e\u0431\u044f\u0442\u0441\u044f \u0442\u0440\u0443\u0434\u043e\u0432\u044b\u0435 \u0434\u043e\u0433\u043e\u0432\u043e\u0440\u044b \u0438 \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044f \u0440\u0430\u0431\u043e\u0442\u043e\u0434\u0430\u0442\u0435\u043b\u044f \u0432 \u0421\u043e\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u043c \u0441\u0442\u0440\u0430\u0445\u043e\u0432\u0430\u043d\u0438\u0438. \u0421\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0440\u0430\u0431\u043e\u0442\u043e\u0434\u0430\u0442\u0435\u043b\u0435\u0439 \u0432\u0445\u043e\u0434\u0438\u0442 \u0432 \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0443 <a href=\"https:\/\/delaguialuzon.com\/ru\/%d1%82%d1%80%d1%83%d0%b4%d0%be%d0%b2%d0%be%d0%b5-%d0%bf%d1%80%d0%b0%d0%b2%d0%be\/\">\u0442\u0440\u0443\u0434\u043e\u0432\u043e\u0433\u043e \u043f\u0440\u0430\u0432\u0430<\/a>.<\/p><h2>\u041a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u043f\u043e \u0437\u0430\u043f\u0443\u0441\u043a\u0443 \u043e\u043d\u043b\u0430\u0439\u043d-\u0431\u0438\u0437\u043d\u0435\u0441\u0430 \u0432 \u0418\u0441\u043f\u0430\u043d\u0438\u0438<\/h2><p>Delagu\u00eda y Luz\u00f3n \u0441 1960 \u0433\u043e\u0434\u0430 \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0430\u0435\u0442 \u043f\u0440\u0435\u0434\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u0435\u0439 \u0432 \u0418\u0441\u043f\u0430\u043d\u0438\u0438, \u0432 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435 \u043d\u0430 \u0440\u0443\u0441\u0441\u043a\u043e\u043c \u044f\u0437\u044b\u043a\u0435. \u041d\u0430\u0448 \u043e\u0444\u0438\u0441 \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0432 \u0412\u0430\u043b\u0435\u043d\u0441\u0438\u0438. \u041c\u044b \u043f\u043e\u043c\u043e\u0436\u0435\u043c \u0432\u044b\u0431\u0440\u0430\u0442\u044c \u0444\u043e\u0440\u043c\u0443 \u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0431\u0438\u0437\u043d\u0435\u0441\u0430, \u043d\u0430\u0441\u0442\u0440\u043e\u0438\u0442\u044c \u043d\u0430\u043b\u043e\u0433\u043e\u043e\u0431\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u0438\u0442\u044c \u044e\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0442\u0435\u043a\u0441\u0442\u044b \u0441\u0430\u0439\u0442\u0430 \u0438 \u0443\u0441\u043b\u043e\u0432\u0438\u044f \u043f\u0440\u043e\u0434\u0430\u0436\u0438 \u0432 \u0440\u0430\u043c\u043a\u0430\u0445 \u043f\u0440\u0430\u043a\u0442\u0438\u043a <a href=\"https:\/\/delaguialuzon.com\/ru\/%d0%ba%d0%be%d0%bc%d0%bc%d0%b5%d1%80%d1%87%d0%b5%d1%81%d0%ba%d0%be%d0%b5-%d0%bf%d1%80%d0%b0%d0%b2%d0%be\/\">\u043a\u043e\u043c\u043c\u0435\u0440\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043f\u0440\u0430\u0432\u0430<\/a> \u0438 <a href=\"https:\/\/delaguialuzon.com\/ru\/%d0%bd%d0%b0%d0%bb%d0%be%d0%b3%d0%be%d0%b2%d0%be%d0%b5-%d0%bf%d1%80%d0%b0%d0%b2%d0%be-%d0%b8-%d0%b1%d1%83%d1%85%d0%b3%d0%b0%d0%bb%d1%82%d0%b5%d1%80%d1%81%d0%ba%d0%b8%d0%b9-%d1%83%d1%87%d0%b5%d1%82\/\">\u043d\u0430\u043b\u043e\u0433\u043e\u0432\u043e\u0433\u043e \u043f\u0440\u0430\u0432\u0430<\/a>.<\/p><p>\u041f\u043e\u0437\u0432\u043e\u043d\u0438\u0442\u0435 \u043d\u0430\u043c \u043f\u043e \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443 <a href=\"tel:+34963741657\">+34 963 74 16 57<\/a>, \u043d\u0430\u043f\u0438\u0448\u0438\u0442\u0435 \u043d\u0430 <a href=\"mailto:felix.delaguia@delaguialuzon.com\">felix.delaguia@delaguialuzon.com<\/a> \u0438\u043b\u0438 \u0432\u043e\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435\u0441\u044c <a href=\"https:\/\/delaguialuzon.com\/ru\/%d0%ba%d0%be%d0%bd%d1%82%d0%b0%d0%ba%d1%82%d1%8b\/\">\u0444\u043e\u0440\u043c\u043e\u0439 \u043d\u0430 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0435 \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u043e\u0432<\/a>.<\/p>"},"elements":[],"widgetType":"text-editor"}],"isInner":false}]