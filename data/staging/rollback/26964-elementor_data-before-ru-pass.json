ng style=\"color: #708473;\">295 \u0435\u0432\u0440\u043e<\/strong> (\u0432\u043a\u043b\u044e\u0447\u0430\u044f \u041d\u0414\u0421 \u0438 \u0433\u043e\u0441\u043f\u043e\u0448\u043b\u0438\u043d\u0443).<\/li><li>\u041c\u044b \u0433\u043e\u0432\u043e\u0440\u0438\u043c \u043d\u0430 <strong style=\"color: #708473;\">\u0440\u0443\u0441\u0441\u043a\u043e\u043c, \u0438\u0441\u043f\u0430\u043d\u0441\u043a\u043e\u043c, \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u043c, \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u043c \u0438 \u043d\u0435\u043c\u0435\u0446\u043a\u043e\u043c<\/strong> \u044f\u0437\u044b\u043a\u0430\u0445.<\/li><\/ul><\/div><h2 class=\"wp-block-heading\">\u041f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u0435 \u0432\u0438\u0434\u0430 \u043d\u0430 \u0436\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0432 \u0418\u0441\u043f\u0430\u043d\u0438\u0438 \u0434\u043b\u044f \u0433\u0440\u0430\u0436\u0434\u0430\u043d \u0423\u043a\u0440\u0430\u0438\u043d\u044b<\/h2><p><strong>\u0412\u0438\u0434 \u043d\u0430 \u0436\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0432 \u0418\u0441\u043f\u0430\u043d\u0438\u0438<\/strong> \u2014 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0439 \u0448\u0430\u0433 \u0434\u043b\u044f \u0433\u0440\u0430\u0436\u0434\u0430\u043d \u0423\u043a\u0440\u0430\u0438\u043d\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u0440\u043e\u0436\u0438\u0432\u0430\u044e\u0442 \u0432 \u0441\u0442\u0440\u0430\u043d\u0435 \u043f\u043e \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0435 \u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0437\u0430\u0449\u0438\u0442\u044b. \u041c\u044b \u043f\u043e\u043c\u043e\u0436\u0435\u043c \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c, \u043a\u0430\u043a\u043e\u0439 \u0442\u0438\u043f \u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0446\u0438\u0438 \u043f\u043e\u0434\u0445\u043e\u0434\u0438\u0442 \u0438\u043c\u0435\u043d\u043d\u043e \u0432 \u0432\u0430\u0448\u0435\u0439 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438, \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u0438\u043c \u0432\u0441\u0435 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u044b\u0435 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u044b \u0438 \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0434\u0438\u043c \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u0443 \u043e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u0438\u044f.<\/p><p>\u0417\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0435 \u0433\u043e\u0434\u044b \u043c\u043d\u043e\u0433\u0438\u0435 \u0433\u0440\u0430\u0436\u0434\u0430\u043d\u0435 \u0423\u043a\u0440\u0430\u0438\u043d\u044b \u0443\u0441\u043f\u0435\u0448\u043d\u043e \u0438\u043d\u0442\u0435\u0433\u0440\u0438\u0440\u043e\u0432\u0430\u043b\u0438\u0441\u044c \u0432 \u0438\u0441\u043f\u0430\u043d\u0441\u043a\u043e\u0435 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e: \u043d\u0430\u0448\u043b\u0438 \u0440\u0430\u0431\u043e\u0442\u0443, \u043e\u0442\u043a\u0440\u044b\u043b\u0438 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0431\u0438\u0437\u043d\u0435\u0441, \u043f\u043e\u0441\u0442\u0443\u043f\u0438\u043b\u0438 \u043d\u0430 \u0443\u0447\u0451\u0431\u0443, \u0441\u043e\u0437\u0434\u0430\u043b\u0438 \u0441\u0435\u043c\u044c\u0438 \u0438\u043b\u0438 \u043f\u0440\u0438\u043e\u0431\u0440\u0435\u043b\u0438 \u043d\u0435\u0434\u0432\u0438\u0436\u0438\u043c\u043e\u0441\u0442\u044c. \u0421\u0435\u0433\u043e\u0434\u043d\u044f \u0438\u0441\u043f\u0430\u043d\u0441\u043a\u043e\u0435 \u0437\u0430\u043a\u043e\u043d\u043e\u0434\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u043f\u0435\u0440\u0435\u0439\u0442\u0438 \u0441 \u0440\u0435\u0436\u0438\u043c\u0430 \u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u