u043f\u0430\u043a\u0435\u0442 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u043e\u0432 \u0434\u043b\u044f \u043f\u043e\u0434\u0430\u0447\u0438<\/td><\/tr><tr style=\"background: #f5f7f5;\"><td style=\"padding: 10px; border-bottom: 1px solid #ddd;\">4. \u041f\u043e\u0434\u0430\u0447\u0430 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u043e\u0432<\/td><td style=\"padding: 10px; border-bottom: 1px solid #ddd;\">\u041f\u043e\u0434\u0430\u0451\u043c \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u044b \u0432 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u043c \u0432\u0438\u0434\u0435 \u0432 \u043a\u043e\u043c\u043f\u0435\u0442\u0435\u043d\u0442\u043d\u044b\u0439 \u0433\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u043e\u0440\u0433\u0430\u043d<\/td><\/tr><tr><td style=\"padding: 10px;\">5. \u0421\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0435\u043d\u0438\u0435<\/td><td style=\"padding: 10px;\">\u041a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u0443\u0435\u043c \u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u043d\u0438\u0435 \u0437\u0430\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0438\u0440\u0443\u0435\u043c \u043e \u0445\u043e\u0434\u0435 \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u044b \u0434\u043e \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f<\/td><\/tr><\/tbody><\/table><\/div><h2 class=\"wp-block-heading\">\u0412 \u043a\u0430\u043a\u0438\u0445 \u0441\u043b\u0443\u0447\u0430\u044f\u0445 \u043c\u044b \u043c\u043e\u0436\u0435\u043c \u043f\u043e\u043c\u043e\u0447\u044c?<\/h2><p>\u041c\u044b \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0430\u0435\u043c \u043e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u0438\u0435 \u0431\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u0430 \u0432\u0438\u0434\u043e\u0432 \u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0446\u0438\u0438, \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u0445 \u0434\u043b\u044f \u043b\u0438\u0446, \u043d\u0430\u0445\u043e\u0434\u044f\u0449\u0438\u0445\u0441\u044f \u0432 \u0418\u0441\u043f\u0430\u043d\u0438\u0438 \u043f\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0437\u0430\u0449\u0438\u0442\u0435:<\/p><ul><li>\u0420\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u043d\u0430 \u043f\u0440\u043e\u0436\u0438\u0432\u0430\u043d\u0438\u0435 \u0438 \u0440\u0430\u0431\u043e\u0442\u0443 \u043f\u043e \u043d\u0430\u0439\u043c\u0443<\/li><li>\u0420\u0435\u0437\u0438\u0434\u0435\u043d\u0446\u0438\u044f \u0434\u043b\u044f \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u044b\u0445 \u043f\u0440\u0435\u0434\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u0435\u0439 (<em>Aut\u00f3nomo<\/em>)<\/li><li>\u0412\u0441\u0435 \u0432\u0438\u0434\u044b <em>Arraigo<\/em> (\u0432 \u0442\u043e\u043c \u0447\u0438\u0441\u043b\u0435 <em>Arraigo Socioformativo<\/em>)<\/li><li>\u0420\u0435\u0437\u0438\u0434\u0435\u043d\u0446\u0438\u044f \u0434\u043b\u044f \u0447\u043b\u0435\u043d\u043e\u0432 \u0441\u0435\u043c\u044c\u0438 \u0433\u0440\u0430\u0436\u0434\u0430\u043d \u0418\u0441\u043f\u0430\u043d\u0438\u0438<\/li><li>\u0412\u0438\u0434\u044b \u043d\u0430 \u0436\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u043f\u043e <a href=\"https:\/\/www.boe.es\/buscar\/act.php?id=BOE-A-2013-12137\" target=\"_blank\" rel=\"noopener\">\u0417\u0430\u043a\u043e\u043d\u0443 14\/2013<\/a>: Digital Nomad, \u0432\u044b\u0441\u043e\u043a\u043e\u043a\u0432\u0430\u043b\u0438\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442, \u043f\u0440\u0435\u0434\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438 \u043c\u0435\u0436\u0434\u0443\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0439 \u043c\u043e\u0431\u0438\u043b\u044c\u043d\u043e\u0441\u0442\u0438<\/li><li>\u0414\u043e\u043b\u0433\u043e\u0441\u0440\u043e\u0447\u043d\u0430\u044f \u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0446\u0438\u044f (<em>Residencia de Larga Duraci\u00f3n<\/em>), \u0435\u0441\u043b\u0438 \u0441\u043e\u0431\u043b\u044e\u0434\u0435\u043d\u044b \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u044f \u0437\u0430\u043a\u043e\u043d\u043e\u0434\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u0430<\/li><\/ul><div class=\"codebox\" style=\"border-left: 4px solid #708473; background: #fafbfa; padding: 18px 24px; border-radius: 0 8px 8px 0; margin: 25px 0; line-height: 1.7;\"><p style=\"margin: 0;\"><strong style=\"color: #708473;\">\u0421\u043e\u0432\u0435\u0442:<\/strong> \u0435\u0441\u043b\u0438 \u0432\u044b \u043d\u0435 \u0443\u0432\u0435\u0440\u0435\u043d\u044b, \u043a\u0430\u043a\u043e\u0439 \u0432\u0430\u0440\u0438\u0430\u043d\u0442 \u043f\u043e\u0434\u0445\u043e\u0434\u0438\u0442 \u0438\u043c\u0435\u043d\u043d\u043e \u0432\u0430\u043c, \u043c\u044b \u043f\u043e\u0434\u0440\u043e\u0431\u043d\u043e \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u043c \u0432\u0441\u0435 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u044b\u0435 \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0438 \u043f\u043e\u043c\u043e\u0436\u0435\u043c \u0432\u044b\u0431\u0440\u0430\u0442\u044c \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u0432\u044b\u0433\u043e\u0434\u043d\u043e\u0435.<\/p><\/div><h2 class=\"wp-block-heading\">\u0421\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u044c \u043f\u043e\u043b\u043d\u043e\u0433\u043e \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0435\u043d\u0438\u044f<\/h2><div class=\"codebox\" style=\"border: 2px solid #708473; background: #ffffff; padding: 20px; border-radius: 10px; line-height: 1.7; margin: 25px 0;\"><h3 style=\"margin: 0 0 12px 0; color: #708473;\">295 \u0435\u0432\u0440\u043e \u2014 \u0444\u0438\u043a\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u0441\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u044c<\/h3><p>\u0412 \u0441\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u044c \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u043e:<\/p><ul style=\"margin: 0; padding-left: 18px;\"><li>\u041f\u0435\u0440\u0432\u0438\u0447\u043d\u0430\u044f \u044e\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f \u0438 \u0430\u043d\u0430\u043b\u0438\u0437 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438<\/li><li>\u041f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u0445 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u043e\u0432<\/li><li>\u0421\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u0447\u043d\u044f \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u044b\u0445 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u043e\u0432<\/li><li>\u041f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0430 \u043f\u043e\u043b\u043d\u043e\u0433\u043e \u043f\u0430\u043a\u0435\u0442\u0430 \u0437\u0430\u044f\u0432\u043b\u0435\u043d\u0438\u044f<\/li><li>\u042d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u0430\u044f \u043f\u043e\u0434\u0430\u0447\u0430 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u043e\u0432 \u0432 \u043a\u043e\u043c\u043f\u0435\u0442\u0435\u043d\u0442\u043d\u044b\u0439 \u043e\u0440\u0433\u0430\u043d<\/li><li>\u041a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u043d\u0438\u044f \u0437\u0430\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u0438 \u0438\u043d\u0444\u043e\u0440\u043c\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043e \u0445\u043e\u0434\u0435 \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u044b<\/li><li>\u041d\u0414\u0421<\/li><li>\u0413\u043e\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f \u043f\u043e\u0448\u043b\u0438\u043d\u0430 \u043f\u043e \u0444\u043e\u0440\u043c\u0435 Modelo 790-052<\/li><\/ul><p style=\"margin-top: 12px;\"><strong>\u041d\u0438\u043a\u0430\u043a\u0438\u0445 \u0441\u043a\u0440\u044b\u0442\u044b\u0445 \u043f\u043b\u0430\u0442\u0435\u0436\u0435\u0439.<\/strong><\/p><\/div><h2 class=\"wp-block-heading\">\u0427\u0442\u043e \u043d\u0435 \u0432\u0445\u043e\u0434\u0438\u0442 \u0432 \u0441\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u044c?<\/h2><ul><li>\u041e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u0438\u0435 \u043a\u0430\u0440\u0442\u044b TIE \u043f\u043e\u0441\u043b\u0435 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u043f\u043e\u043b\u043e\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u0440\u0435\u0448\u0435\u043d\u0438\u044f<\/li><li>\u0417\u0430\u043f\u0438\u0441\u044c \u043d\u0430 \u0441\u0434\u0430\u0447\u0443 \u043e\u0442\u043f\u0435\u0447\u0430\u0442\u043a\u043e\u0432 \u043f\u0430\u043b\u044c\u0446\u0435\u0432<\/li><li>\u0423\u0441\u043b\u0443\u0433\u0438 \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u0440\u0438\u0441\u044f\u0436\u043d\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0447\u0438\u043a\u0430<\/li><li>\u0410\u043f\u043e\u0441\u0442\u0438\u043b\u044c \u0438 \u043b\u0435\u0433\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u0438\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u044b\u0445 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u043e\u0432<\/li><li>\u041d\u043e\u0442\u0430\u0440\u0438\u0430\u043b\u044c\u043d\u044b\u0435 \u0443\u0441\u043b\u0443\u0433\u0438<\/li><li>\u0410\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043d\u044b\u0435 \u0438 \u0441\u0443\u0434\u0435\u0431\u043d\u044b\u0435 \u043e\u0431\u0436\u0430\u043b\u043e\u0432\u0430\u043d\u0438\u044f \u0432 \u0441\u043b\u0443\u0447\u0430\u0435 \u043e\u0442\u043a\u0430\u0437\u0430<\/li><\/ul><p>\u0415\u0441\u043b\u0438 \u0432 \u0432\u0430\u0448\u0435\u043c \u0441\u043b\u0443\u0447\u0430\u0435 \u043f\u043e\u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u043a\u0430\u043a\u0430\u044f-\u043b\u0438\u0431\u043e \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u0443\u0441\u043b\u0443\u0433\u0430, \u043c\u044b \u0437\u0430\u0440\u0430\u043d\u0435\u0435 \u0441\u043e\u043e\u0431\u0449\u0438\u043c \u0435\u0451 \u0441\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u044c. \u0412\u044b \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0442\u0435 \u043f\u043e\u043d\u0438\u043c\u0430\u0442\u044c, \u0437\u0430 \u0447\u0442\u043e \u043f\u043b\u0430\u0442\u0438\u0442\u0435.<\/p><h2 class=\"wp-block-heading\">\u041f\u043e\u0447\u0435\u043c\u0443 \u0441\u0442\u043e\u0438\u0442 \u043e\u0431\u0440\u0430\u0442\u0438\u0442\u044c\u0441\u044f \u043a \u044e\u0440\u0438\u0441\u0442\u0443?<\/h2><p>\u041c\u0438\u0433\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0435 \u0437\u0430\u043a\u043e\u043d\u043e\u0434\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0418\u0441\u043f\u0430\u043d\u0438\u0438 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u043e \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0435\u0442\u0441\u044f, \u0430 \u043a\u0430\u0436\u0434\u0430\u044f \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u0430 \u0438\u043c\u0435\u0435\u0442 \u0441\u0432\u043e\u0438 \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438. \u041d\u0430\u043b\u0438\u0447\u0438\u0435 \u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0437\u0430\u0449\u0438\u0442\u044b \u0441\u0430\u043c\u043e \u043f\u043e \u0441\u0435\u0431\u0435 \u043d\u0435 \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043f\u0440\u0430\u0432\u0430 \u043d\u0430 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u0435 \u0434\u0440\u0443\u0433\u043e\u0433\u043e \u0432\u0438\u0434\u0430 \u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0446\u0438\u0438. \u041d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c \u043f\u0440\u0430\u0432\u043e\u0432\u043e\u0435 \u043e\u0441\u043d\u043e\u0432\u0430\u043d\u0438\u0435, \u043e\u0446\u0435\u043d\u0438\u0442\u044c \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u044b, \u0441\u043e\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0435 \u0441\u0440\u043e\u043a\u043e\u0432 \u0438 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u044f\u043c \u0437\u0430\u043a\u043e\u043d\u0430.<\/p><p>\u041e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u044b\u0445 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0439 \u043d\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442. \u0427\u0435\u043b\u043e\u0432\u0435\u043a, \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0449\u0438\u0439 \u043f\u043e \u0442\u0440\u0443\u0434\u043e\u0432\u043e\u043c\u0443 \u0434\u043e\u0433\u043e\u0432\u043e\u0440\u0443, \u043f\u0440\u0435\u0434\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u044c, \u0441\u0442\u0443\u0434\u0435\u043d\u0442, \u0441\u0435\u043c\u044c\u044f \u0441 \u0434\u0435\u0442\u044c\u043c\u0438 \u0438\u043b\u0438 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442, \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0449\u0438\u0439 \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e \u043d\u0430 \u0438\u043d\u043e\u0441\u0442\u0440\u0430\u043d\u043d\u0443\u044e \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u044e, \u0431\u0443\u0434\u0443\u0442 \u043e\u0444\u043e\u0440\u043c\u043b\u044f\u0442\u044c \u0441\u043e\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u043e \u0440\u0430\u0437\u043d\u044b\u0435 \u0432\u0438\u0434\u044b \u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0446\u0438\u0438. \u041d\u0430\u0448\u0430 \u0437\u0430\u0434\u0430\u0447\u0430 \u2014 \u043f\u043e\u0434\u043e\u0431\u0440\u0430\u0442\u044c \u0438\u043c\u0435\u043d\u043d\u043e \u0442\u043e\u0442 \u0432\u0430\u0440\u0438\u0430\u043d\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u0432\u0430\u0448\u0438\u043c \u0438\u043d\u0442\u0435\u0440\u0435\u0441\u0430\u043c.<\/p><h2 class=\"wp-block-heading\">\u041a\u0430\u043a\u0438\u0435 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u044b \u043f\u043e\u043d\u0430\u0434\u043e\u0431\u044f\u0442\u0441\u044f?<\/h2><div class=\"codebox\" style=\"margin: 25px 0; border: 2px solid #708473; border-radius: 10px; padding: 15px; background: #ffffff;\"><h3 style=\"margin-bottom: 15px;\">\u0414\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u044b \u0434\u043b\u044f \u043f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u0430\u043d\u0430\u043b\u0438\u0437\u0430<\/h3><table style=\"width: 100%; border-collapse: collapse;\"><thead><tr><th style=\"padding: 10px; border-bottom: 2px solid #708473; text-align: left;\">\u0414\u043e\u043a\u0443\u043c\u0435\u043d\u0442<\/th><th style=\"padding: 10px; border-bottom: 2px solid #708473; text-align: left;\">\u041f\u0440\u0438\u043c\u0435\u0447\u0430\u043d\u0438\u0435<\/th><\/tr><\/thead><tbody><tr><td style=\"padding: 10px; border-bottom: 1px solid #ddd;\">\u0414\u0435\u0439\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0439 \u0437\u0430\u0433\u0440\u0430\u043d\u0438\u0447\u043d\u044b\u0439 \u043f\u0430\u0441\u043f\u043e\u0440\u0442<\/td><td style=\"padding: 10px; border-bottom: 1px solid #ddd;\">\u041e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e<\/td><\/tr><tr style=\"background: #f5f7f5;\"><td style=\"padding: 10px; border-bottom: 1px solid #ddd;\">\u041a\u0430\u0440\u0442\u0430 \u0438\u043b\u0438 \u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u043e \u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0437\u0430\u0449\u0438\u0442\u0435<\/td><td style=\"padding: 10px; border-bottom: 1px solid #ddd;\">\u041e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e<\/td><\/tr><tr><td style=\"padding: 10px; border-bottom: 1px solid #ddd;\">Certificado de empadronamiento<\/td><td style=\"padding: 10px; border-bottom: 1px solid #ddd;\">\u041e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e<\/td><\/tr><tr style=\"background: #f5f7f5;\"><td style=\"padding: 10px; border-bottom: 1px solid #ddd;\">\u0414\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u044b \u043e \u0442\u0440\u0443\u0434\u043e\u0432\u043e\u0439 \u0434\u0435\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u0438<\/td><td style=\"padding: 10px; border-bottom: 1px solid #ddd;\">\u041f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438<\/td><\/tr><tr><td style=\"padding: 10px; border-bottom: 1px solid #ddd;\">\u0414\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u044b \u043e\u0431 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0438<\/td><td style=\"padding: 10px; border-bottom: 1px solid #ddd;\">\u0415\u0441\u043b\u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u043c\u043e<\/td><\/tr><tr style=\"background: #f5f7f5;\"><td style=\"padding: 10px; border-bottom: 1px solid #ddd;\">\u0414\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u044b \u043e \u0441\u0435\u043c\u0435\u0439\u043d\u043e\u043c \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0438<\/td><td style=\"padding: 10px; border-bottom: 1px solid #ddd;\">\u041f\u0440\u0438 \u043d\u0430\u043b\u0438\u0447\u0438\u0438<\/td><\/tr><tr><td style=\"padding: 10px;\">\u0414\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u044b \u043e\u0431 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u0438 \u0432 \u0418\u0441\u043f\u0430\u043d\u0438\u0438<\/td><td style=\"padding: 10px;\">\u041b\u044e\u0431\u044b\u0435 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f<\/td><\/tr><\/tbody><\/table><\/div><p>\u041f\u043e\u0441\u043b\u0435 \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044f \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u043e\u0432 \u043c\u044b \u0441\u043e\u043e\u0431\u0449\u0438\u043c, \u043a\u0430\u043a\u043e\u0439 \u043f\u0443\u0442\u044c \u043b\u0435\u0433\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449\u0438\u043c \u0438\u043c\u0435\u043d\u043d\u043e \u0434\u043b\u044f \u0432\u0430\u0441.<\/p><div class=\"codebox\" style=\"border: 2px solid #708473; background: #ffffff; padding: 28px; border-radius: 10px; margin: 30px 0; text-align: center; line-height: 1.7;\"><h3 style=\"margin: 0 0 12px 0; color: #708473;\">\u041d\u0430\u0447\u043d\u0438\u0442\u0435 \u043e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u0438\u0435 \u0443\u0436\u0435 \u0441\u0435\u0433\u043e\u0434\u043d\u044f<\/h3><p style=\"margin: 0 0 18px 0; color: #444;\">\u0421\u043f\u0435\u0446\u0438\u0430\u043b\u0438\u0441\u0442\u044b <strong>Delagu\u00eda &amp; Luz\u00f3n Abogados<\/strong> \u0433\u043e\u0442\u043e\u0432\u044b \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0430\u0442\u044c \u0432\u0430\u0441 \u043d\u0430 \u043a\u0430\u0436\u0434\u043e\u043c \u044d\u0442\u0430\u043f\u0435 \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u044b. \u041f\u043e\u043b\u043d\u043e\u0435 \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u2014 <strong>295 \u0435\u0432\u0440\u043e<\/strong> (\u0432\u043a\u043b\u044e\u0447\u0430\u044f \u041d\u0414\u0421 \u0438 \u0433\u043e\u0441\u043f\u043e\u0448\u043b\u0438\u043d\u0443 Modelo 790-052).<\/p><p><a style=\"display: inline-block; background: #708473; color: #ffffff; font-weight: bold; padding: 14px 32px; border-radius: 8px; text-decoration: none;\" href=\"https:\/\/delaguialuzon.com\/ru\/contact\/\">\u0421\u0432\u044f\u0437\u0430\u0442\u044c\u0441\u044f \u0441 \u043d\u0430\u043c\u0438<\/a><\/p><\/div><h2 class=\"wp-block-heading\">\u0427\u0430\u0441\u0442\u043e \u0437\u0430\u0434\u0430\u0432\u0430\u0435\u043c\u044b\u0435 \u0432\u043e\u043f\u0440\u043e\u0441\u044b<\/h2><details><summary><strong>\u041c\u043e\u0433\u0443 \u043b\u0438 \u044f \u043f\u0435\u0440\u0435\u0439\u0442\u0438 \u0441 \u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u0437\u0430\u0449\u0438\u0442\u044b \u043d\u0430 \u0434\u0440\u0443\u0433\u043e\u0439 \u0432\u0438\u0434 \u043d\u0430 \u0436\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e?<\/strong><\/summary><p>\u0414\u0430, \u0438\u0441\u043f\u0430\u043d\u0441\u043a\u043e\u0435 \u0437\u0430\u043a\u043e\u043d\u043e\u0434\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u0442\u0430\u043a\u0443\u044e \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u043f\u0440\u0438 \u0441\u043e\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0438 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u0439 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u0439 \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u044b. \u041c\u044b \u043f\u043e\u043c\u043e\u0436\u0435\u043c \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449\u0438\u0439 \u0432\u0430\u0440\u0438\u0430\u043d\u0442.<\/p><\/details><details><summary><strong>\u0421\u043a\u043e\u043b\u044c\u043a\u043e \u0441\u0442\u043e\u0438\u0442 \u043f\u043e\u043b\u043d\u043e\u0435 \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0435\u043d\u0438\u0435?<\/strong><\/summary><p>\u0424\u0438\u043a\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u0441\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u044c \u2014 295 \u0435\u0432\u0440\u043e. \u0412 \u043d\u0435\u0451 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u044b \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044f, \u043f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0430 \u0438 \u043f\u043e\u0434\u0430\u0447\u0430 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u043e\u0432, \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c \u0440\u0430\u0441\u0441\u043c\u043e\u0442\u0440\u0435\u043d\u0438\u044f, \u041d\u0414\u0421 \u0438 \u0433\u043e\u0441\u043f\u043e\u0448\u043b\u0438\u043d\u0430. \u041d\u0438\u043a\u0430\u043a\u0438\u0445 \u0441\u043a\u0440\u044b\u0442\u044b\u0445 \u043f\u043b\u0430\u0442\u0435\u0436\u0435\u0439.<\/p><\/details><details><summary><strong>\u041a\u0430\u043a\u0438\u0435 \u0432\u0438\u0434\u044b \u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0446\u0438\u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b?<\/strong><\/summary><p>\u0420\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u043d\u0430 \u0440\u0430\u0431\u043e\u0442\u0443 \u043f\u043e \u043d\u0430\u0439\u043c\u0443, \u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0446\u0438\u044f \u0434\u043b\u044f \u043f\u0440\u0435\u0434\u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0442\u0435\u043b\u0435\u0439, \u0432\u0441\u0435 \u0432\u0438\u0434\u044b Arraigo, \u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0446\u0438\u044f \u0434\u043b\u044f \u0447\u043b\u0435\u043d\u043e\u0432 \u0441\u0435\u043c\u044c\u0438 \u0433\u0440\u0430\u0436\u0434\u0430\u043d \u0418\u0441\u043f\u0430\u043d\u0438\u0438, Digital Nomad \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438 \u043f\u043e \u0417\u0430\u043a\u043e\u043d\u0443 14\/2013, \u0430 \u0442\u0430\u043a\u0436\u0435 \u0434\u043e\u043b\u0433\u043e\u0441\u0440\u043e\u0447\u043d\u0430\u044f \u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0446\u0438\u044f.<\/p><\/details><details><summary><strong>\u041d\u0430 \u043a\u0430\u043a\u0438\u0445 \u044f\u0437\u044b\u043a\u0430\u0445 \u0432\u044b \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442\u0435?<\/strong><\/summary><p>\u041c\u044b \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u0435\u043c \u043a\u043b\u0438\u0435\u043d\u0442\u043e\u0432 \u043d\u0430 \u0440\u0443\u0441\u0441\u043a\u043e\u043c, \u0438\u0441\u043f\u0430\u043d\u0441\u043a\u043e\u043c, \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u043c, \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u043c \u0438 \u043d\u0435\u043c\u0435\u0446\u043a\u043e\u043c \u044f\u0437\u044b\u043a\u0430\u0445.<\/p><\/details><details><summary><strong>\u041d\u0443\u0436\u043d\u043e \u043b\u0438 \u043c\u043d\u0435 \u043f\u0440\u0438\u0445\u043e\u0434\u0438\u0442\u044c \u0432 \u043e\u0444\u0438\u0441 \u043b\u0438\u0447\u043d\u043e?<\/strong><\/summary><p>\u041d\u0435 \u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e. \u041c\u044b \u043c\u043e\u0436\u0435\u043c \u043f\u0440\u043e\u0432\u0435\u0441\u0442\u0438 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0430\u0446\u0438\u044e \u0438 \u043f\u0440\u0438\u043d\u044f\u0442\u044c \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u044b \u0434\u0438\u0441\u0442\u0430\u043d\u0446\u0438\u043e\u043d\u043d\u043e. \u041f\u043e\u0434\u0430\u0447\u0430 \u0437\u0430\u044f\u0432\u043b\u0435\u043d\u0438\u044f \u043e\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0432 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u043e\u043c \u0432\u0438\u0434\u0435.<\/p><\/details><hr \/><div style=\"background-color: #f5f5f5; padding: 28px; border-radius: 10px; line-height: 1.8; margin-top: 30px;\"><h3 style=\"margin-bottom: 18px;\">\u0421\u0432\u044f\u0436\u0438\u0442\u0435\u0441\u044c \u0441 \u043d\u0430\u043c\u0438<\/h3><p>\u041a\u043e\u043c\u0430\u043d\u0434\u0430 <strong>Delagu\u00eda &amp; Luz\u00f3n Abogados<\/strong> \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u044e\u0440\u0438\u0434\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u043f\u043e \u0432\u043e\u043f\u0440\u043e\u0441\u0430\u043c <a href=\"https:\/\/delaguialuzon.com\/ru\/droit-des-etrangers\/\">\u043c\u0438\u0433\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0433\u043e \u043f\u0440\u0430\u0432\u0430<\/a> \u0438 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u0432\u0438\u0434\u0430 \u043d\u0430 \u0436\u0438\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e \u0432 \u0418\u0441\u043f\u0430\u043d\u0438\u0438.<\/p><p>\u041c\u044b \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u0435\u043c \u043a\u043b\u0438\u0435\u043d\u0442\u043e\u0432 \u043d\u0430 <strong>\u0440\u0443\u0441\u0441\u043a\u043e\u043c, \u0438\u0441\u043f\u0430\u043d\u0441\u043a\u043e\u043c, \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u043c, \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u043e\u043c \u0438 \u043d\u0435\u043c\u0435\u0446\u043a\u043e\u043c<\/strong> \u044f\u0437\u044b\u043a\u0430\u0445.<\/p><p>Avinguda Regne de Valencia, 6, 1 - 2, 46005 Valencia (\u0418\u0441\u043f\u0430\u043d\u0438\u044f)<\/p><p>\u041f\u043e\u043d\u0435\u0434\u0435\u043b\u044c\u043d\u0438\u043a-\u0427\u0435\u0442\u0432\u0435\u0440\u0433: 08:30-18:00 | \u041f\u044f\u0442\u043d\u0438\u0446\u0430: 08:30-15:00<\/p><p><a href=\"mailto:felix.delaguia@delaguialuzon.com\">felix.delaguia@delaguialuzon.com<\/a> | <a href=\"mailto:sonia.gomezluzon@delaguialuzon.com\">sonia.gomezluzon@delaguialuzon.com<\/a><\/p><p>+34 963 74 16 57<\/p><p><a href=\"https:\/\/delaguialuzon.com\/ru\/\">https:\/\/delaguialuzon.com<\/a><\/p><\/div>"},"elements":[],"widgetType":"text-editor"}],"isInner":false}]